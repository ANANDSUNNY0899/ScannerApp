# ==============================================================================
# Document Scanner Cloud Backend - Environment Configuration Template
# Copy this file to `.env` for local testing. Do NOT commit your actual `.env`!
# ==============================================================================

# Server Port (Render sets this dynamically via $PORT)
PORT=8080

# PostgreSQL Database Connection String
# Example: postgres://username:password@hostname:5432/database_name?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scannerapp?sslmode=disable

# Redis Cache & Rate Limiting
# Example: red-xxxx:6379 or localhost:6379
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# JWT Authentication
# Generate a cryptographically secure string (e.g. `openssl rand -hex 32`)
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRATION_HOURS=72

# Quotas & Rate Limits
MAX_FREE_OCR=5

# S3 / MinIO / Cloudflare R2 Object Storage
# For local MinIO: localhost:9000, S3_USE_SSL=false
# For Cloudflare R2: <account-id>.r2.cloudflarestorage.com, S3_USE_SSL=true
# For AWS S3: s3.<region>.amazonaws.com, S3_USE_SSL=true
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=scans-bucket
S3_USE_SSL=false

# Google Play Developer Service Account (Optional for local sandbox mode)
# Path to service account JSON key for server-to-server subscription verification
GOOGLE_APPLICATION_CREDENTIALS=

# Google Gemini Multimodal API (For Universal Receipt Extraction)
# Get a free API key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

